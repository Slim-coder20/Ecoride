{% extends 'base.html.twig' %}

{% block body %}
	<div class="covoiturage-container">
		<div class="covoiturage-image">
			<img src="{{ asset('images/covoiturage1.jpg') }}" alt="Image covoiturage" class="img-cover">
			<img src="{{ asset('images/covoiturage2.jpg') }}" alt="Image voiture" class="img-cover">
		</div>

		<div class="covoiturage-form">
			<h2 class="form-title">🚘 Trouvez votre trajet</h2>

			{{ form_start(form) }}
			<div class="form-group">
				{{ form_row(form.depart) }}
			</div>
			<div class="form-group">
				{{ form_row(form.arrivee) }}
			</div>
			<div class="form-group">
				{{ form_row(form.date) }}
			</div>
			<div class="form-group">
				<button class="btn btn-primary w-100">Rechercher</button>
			</div>
			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}
