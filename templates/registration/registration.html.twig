{% extends 'base.html.twig' %}

{% block title %}Créer un compte
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<h2>Créer un compte</h2>

		{{ form_start(registerForm) }}
		{{ form_row(registerForm.pseudo) }}
		{{ form_row(registerForm.email) }}
		{{ form_row(registerForm.plainPassword) }}
		<button class="btn btn-success">S'inscrire</button>
		{{ form_end(registerForm) }}

		<a href="{{ path('app_login') }}" class="text-decoration-none text-success p-1">Déjà inscrit ? Connectez-vous</a>
	</div>
{% endblock %}
