{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="container mt-5">
    <h2 class="text-center text-success mb-4">Créer un compte</h2>

    {{ form_start(registerForm) }}
        {{ form_row(registerForm.pseudo) }}
        {{ form_row(registerForm.email) }}
        {{ form_row(registerForm.password) }}
        <button type="submit" class="btn btn-success mt-3">S'inscrire</button>
    {{ form_end(registerForm) }}
</div>
{% endblock %}
