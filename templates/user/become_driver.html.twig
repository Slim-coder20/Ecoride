{% extends 'base.html.twig' %}

{% block title %}Mon espace utilisateur
{% endblock %}

{% block body %}
	{% for message in app.flashes('info') %}
		<div class="alert alert-info">{{ message }}</div>
	{% endfor %}
	<div class="container mt-5">
		<h2 class="text-success">🚗 Mes infos chauffeur</h2>

		{{ form_start(form) }}
		{{ form_row(form.licensePlate) }}
		{{ form_row(form.registrationDate) }}
		{{ form_row(form.model) }}
		{{ form_row(form.brand) }}
		{{ form_row(form.color) }}
		{{ form_row(form.seat) }}
		<button class="btn btn-success">💾 Sauvegarder</button>
		{{ form_end(form) }}
		<a href="{{path('app_user_dashboard')}}" class="btn btn-success">Espace abonné</a>
		<a href="{{ path('app_user_create_trajet')}}" class="btn btn-success">Créé un Trajet</a>
	</div>
{% endblock %}
