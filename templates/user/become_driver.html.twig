{% extends 'base.html.twig' %}

{% block title %}Mon espace utilisateur
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<h2>🚗 Mes infos chauffeur</h2>

		{{ form_start(form) }}
		{{ form_row(form.licensePlate) }}
		{{ form_row(form.registrationDate) }}
		{{ form_row(form.model) }}
		{{ form_row(form.brand) }}
		{{ form_row(form.color) }}
		{{ form_row(form.seat) }}
		{{ form_row(form.preferences) }}
		<button class="btn btn-success">💾 Sauvegarder</button>
		{{ form_end(form) }}
        <a href="{{path('app_user_dashboard')}}" class="btn btn-success">Espace abonné</a>
        <a href="#" class="btn btn-success">Créé un Trajet</a>
	</div>
{% endblock %}
