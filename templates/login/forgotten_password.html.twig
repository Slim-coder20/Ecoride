{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié  | EcoRide
{% endblock %}


{% block body %}
    <section>
        <h2 class="text-success">Rénitilaisation du mot de passe </h2>
        {{form_start(form)}}
        {{ form_row(form.email) }}
        <button type="submit" class="btn btn-success">Envoyer</button>
        <a href="{{ path('app_login') }}" class="btn btn-success">Retour</a>
        
        {{ form_end(form) }}
    </section>
	
{% endblock %}
