{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center text-success">Soumettre un avis</h1>

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Trajet : {{ trajet.depart }} → {{ trajet.arrivee }}</h5>
            <p class="card-text">
                Date de départ : {{ trajet.dateDepart|date('d/m/Y H:i') }}<br>
                Date d'arrivée : {{ trajet.dateArrivee|date('d/m/Y H:i') }}<br>
                Chauffeur : {{ trajet.chauffeur.pseudo}}
            </p>
        </div>
    </div>

    <div class="mt-4">
        {{ form_start(form) }}
            <div class="mb-3">
                {{ form_label(form.note, 'Note (1 à 5)', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.note, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.note) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.commentaire, 'Commentaire', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.commentaire, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                {{ form_errors(form.commentaire) }}
            </div>

            <button type="submit" class="btn btn-success">Soumettre</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}