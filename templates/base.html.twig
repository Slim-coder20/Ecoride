<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}EcoRide
			{% endblock %}
		</title>
		{# <link rel="stylesheet" href="/build/app.css"> #}

		{{ encore_entry_link_tags('app') }}


		{% block stylesheets %}{% endblock %}
		{{ encore_entry_link_tags('app') }}

	</head>
	<script>
		document.addEventListener("DOMContentLoaded", function () {
const fadeElements = document.querySelectorAll('.fade-in');

const observer = new IntersectionObserver((entries) => {
entries.forEach(entry => {
if (entry.isIntersecting) {
entry.target.classList.add('visible');
observer.unobserve(entry.target);
}
});
}, {threshold: 0.1});

fadeElements.forEach(el => observer.observe(el));
});
	</script>


	<body
		class="{{ app.request.attributes.get('_route') == 'app_home' ? 'home-page' : 'default-page' }}">
		<!-- ✅ NAVBAR -->
		<nav class="navbar navbar-expand-lg navbar-dark bg-success w-100">
			<div class="container">
				<a class="navbar-brand text-white fw-bold" href="{{ path('app_home') }}">
					<i class="fa-solid fa-car"></i>
					🌱EcoRide
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse justify-content-end" id="navbarNav">
					<ul class="navbar-nav ms-auto">
						{% if app.user %}
							{% if 'ROLE_EMPLOYE' in app.user.roles %}
								<!-- Navbar pour les employés -->
								<li class="nav-item">
									<span class="nav-link text-white fw-bold">
										<i class="fas fa-user"></i>
										{{ app.user.pseudo }}
									</span>
								</li>
								<li class="nav-item">
									<a class="nav-link text-white" href="{{ path('app_employe') }}">
										<i class="fas fa-tasks"></i>
										Gérer les avis et trajets
									</a>
								</li>
								<li class="nav-item">
									<a class="nav-link text-white" href="{{ path('app_logout') }}">
										<i class="fas fa-sign-out-alt"></i>
										Déconnexion
									</a>
								</li>
							{% else %}
								<!-- Navbar pour les utilisateurs connecté  -->
								<li class="nav-item">
									<a class="nav-link text-white" href="{{ path('app_home') }}">Accueil</a>
								</li>
								<li class="nav-item">
									<a class="nav-link text-white" href="{{ path('app_covoiturage') }}">Covoiturage</a>
								</li>
								<li class="nav-item">
									<a class="nav-link text-white" href="{{ path('app_user_dashboard') }}">
										<i class="fas fa-user"></i>
										Mon compte
									</a>
								</li>
								<span class="nav-link text-white fw-bold">
									<i class="fas fa-user"></i>
									{{ app.user.pseudo }}
								</span>
								<li class="nav-item">
									<a class="nav-link text-white" href="{{ path('app_logout') }}">
										<i class="fas fa-sign-out-alt"></i>
										Déconnexion
									</a>
								</li>

							{% endif %}
						{% else %}
							<!-- Navbar pour les visiteurs non connectés -->
							<li class="nav-item">
								<a class="nav-link text-white" href="{{ path('app_home') }}">Accueil</a>
							</li>
							<li class="nav-item">
								<a class="nav-link text-white" href="{{ path('app_covoiturage') }}">Covoiturage</a>
							</li>
							<li class="nav-item">
								<a class="nav-link text-white" href="{{ path('app_login') }}">
									<i class="fas fa-user"></i>
									Connexion
								</a>
							</li>
							<li class="nav-item">
								<a class="nav-link text-white" href="{{ path('app_contact') }}">Contact</a>
							</li>
						{% endif %}
					</ul>
				</div>
			</div>
		</nav>

		<!-- ✅ FLASH MESSAGES -->
		<div class="container mt-3">
			{% for type, messages in app.flashes %}
				{% for message in messages %}
					<div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
						{{ message }}
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				{% endfor %}
			{% endfor %}
		</div>

		<!-- CONTENU -->
		<div class="container mt-4"> {% block body %}{% endblock %}
			</div>

			<!--FOOTER -->
			<footer class="footer-custom text-dark mt-5 pt-4 pb-4">
				<div class="container text-center">
					<div class="row">
						<div class="col-md-4 mb-3">
							<h5 class="fw-bold text-white">EcoRide</h5>
							<p class="small mb-0 text-white">©
								{{ "now"|date("Y") }}
								EcoRide. Tous droits réservés.</p>
						</div>
						<div class="col-md-4 mb-3">
							<h5 class="fw-bold text-white">Liens rapides</h5>
							<ul class="list-unstyled">
								<li>
									<a href="{{ path('app_home') }}" class="footer-link">Accueil</a>
								</li>
								<li>
									<a href="{{ path('app_covoiturage') }}" class="footer-link">Rechercher un trajet</a>
								</li>
								<li>
									<a href="{{ path('app_login')}}" class="footer-link">Proposer un trajet</a>
								</li>
								<li>
									<a href="{{ path('app_contact') }}" class="footer-link">Contact</a>
								</li>
							</ul>
						</div>
						<div class="col-md-4 mb-3">
							<h5 class="fw-bold text-white">Contact</h5>
							<p class="small mb-1 text-white">123 Rue de Charonne, 75011 Paris</p>
							<p class="small mb-1 text-white">+33 1 23 45 67 89</p>
							<p class="small text-white">contact.ecoride9@gmail.com</p>
						</div>
					</div>
				</div>
			</footer>


			{{ encore_entry_script_tags('app') }}

			{% block javascripts %}{% endblock %}
			{{ encore_entry_script_tags('app') }}
		</body>
	</html>
